{
  "_comment": "Standard default parameters matching original varGP (utils.py, one_cell_fit.py)",

  "run": {
    "mode": "default_gpy",
    "device": "cuda",
    "dtype": "float32"
  },

  "kernel": {
    "_comment_type": "arc_cosine | arc_sine | rbf",
    "type": "arc_cosine",
    "sigma_0": 1.0,
    "Amp": 1.0,
    "beta": 0.1,
    "rho": 0.1,
    "eps_0x": 0.0,
    "eps_0y": 0.0,
    "gradient_mode": "autograd",
    "use_mask": true,
    "bound_rf_center": true,
    "n_sigma_rf_bounds": 3.0,
    "_comment_lengthscale": "only used when type=rbf",
    "lengthscale": 100.0
  },

  "link_function": {
    "A_init": 0.01,
    "lambda0_init": 1.0
  },

  "training": {
    "n_iterations": 50,
    "n_estep": 10,
    "n_fstep": 10,
    "n_mstep": 10,
    "lr": 0.1,
    "optimizer": "lbfgs"
  },

  "early_stopping": {
    "enabled": true,
    "window": 20,
    "threshold": 0.005,
    "min_iterations": 10
  },

  "model": {
    "use_cache": true,
    "jitter": 0.0001,
    "cholesky_max_tries": 3,
    "eigval_tol": 0.0001,
    "gpy_lbfgs_max_iter": 20
  },

  "data": {
    "path": "datasets/PNAS_108x108_original.npz",
    "n_train": 500,
    "n_px_side": null,
    "cellid": 8,
    "ntilde": 100,
    "seed": 42
  },

  "inducing": {
    "selection_method": "pivoted",
    "n_candidates": null,
    "n_samples_sta": null
  },

  "utility": {
    "n_mc_samples": 200,
    "r_max": 100,
    "f_max": 100,
    "adaptive_r_max": false,
    "adaptive_safety_k": 3.0,
    "adaptive_max_rmax": 10000,
    "adaptive_min_rmax": 200
  }
}
