{
  "_comment": "Standard default parameters matching original varGP (utils.py, one_cell_fit.py)",

  "kernel": {
    "sigma_0": 1.0,
    "Amp": 1.0,
    "beta": 0.1,
    "rho": 0.1,
    "eps_0x": 0.0,
    "eps_0y": 0.0,
    "gradient_mode": "autograd",
    "use_mask": true
  },

  "link_function": {
    "A_init": 0.01,
    "lambda0_init": 1.0
  },

  "training": {
    "n_iterations": 50,
    "n_estep": 10,
    "n_fstep": 10,
    "n_mstep": 10,
    "lr": 0.1,
    "optimizer": "lbfgs"
  },

  "early_stopping": {
    "enabled": true,
    "window": 20,
    "threshold": 0.005,
    "min_iterations": 10
  },

  "model": {
    "use_cache": true,
    "jitter": 0.0001
  },

  "data": {
    "n_train": 500,
    "n_px_side": 108,
    "cellid": 8,
    "ntilde": 100,
    "seed": 42
  },

  "utility": {
    "n_mc_samples": 200,
    "r_max": 100
  }
}
